// Hosts the built app as a Worker with static assets; danielgrayling.dev proxies
// /protein-viewer/* to it. Deploy: npm run build -- --base=/protein-viewer/ && npx wrangler deploy
{
  "name": "protein-viewer",
  "compatibility_date": "2026-11-27",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
